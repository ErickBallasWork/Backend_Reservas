# Copia este archivo como .env y llena los valores:  cp .env.example .env
# El .env NUNCA se sube al repositorio (ya está en .gitignore).

# =====================================================================
# Base de datos LOCAL (SQL Server en Docker) — la que usas para probar
# =====================================================================
# Contraseña del usuario "sa" del contenedor. Reglas de SQL Server: mínimo 8 caracteres con
# mayúsculas, minúsculas, números y un símbolo. Evita ; = { } $ y espacios para no complicarte.
DB_SA_PASSWORD=Reservas.Local2026

# Debe llevar la MISMA contraseña de arriba. trustServerCertificate=true solo es aceptable en local.
DATABASE_URL="sqlserver://localhost:1433;database=reservas_dev;user=sa;password=Reservas.Local2026;encrypt=true;trustServerCertificate=true"

# =====================================================================
# Base de datos en AZURE SQL — más adelante, cuando te den las credenciales
# =====================================================================
# Comenta la DATABASE_URL local de arriba y usa esta. Contra Azure solo se usa "npm run db:deploy".
# Si la contraseña tiene ; = { } enciérrala entre llaves: password={mi;clave}
# DATABASE_URL="sqlserver://TU-SERVIDOR.database.windows.net:1433;database=TU-BASE;user=TU-USUARIO;password=TU-CLAVE;encrypt=true;trustServerCertificate=false;connectTimeout=60"


# --- Administrador inicial (lo crea "npm run db:seed") ---
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
# --- Servidor ---
PORT=3001
NODE_ENV=development
# Dominios del frontend que pueden llamar a la API (separados por coma)
FRONTEND_URL=http://localhost:3000
# En producción Swagger queda apagado salvo que pongas true
ENABLE_SWAGGER=true
# Zona horaria para los textos de los avisos
APP_TIME_ZONE=America/Guayaquil

# --- Autenticación ---
# demo   = desarrollo: además del token, acepta la cabecera x-demo-user y POST /auth/demo
# google = real: solo se entra con "Iniciar sesión con Google" (obligatorio en producción)
AUTH_MODE=demo
# Secreto para firmar el token de la API: texto largo y aleatorio (mínimo 32 caracteres).
# En Azure va en Key Vault. Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración de la sesión en horas
JWT_EXPIRES_HOURS=8
# Client ID del cliente OAuth "Web application" (Google Auth Platform). No es secreto.
GOOGLE_CLIENT_ID=
# Dominios de correo que pueden entrar (separados por coma)
ALLOWED_EMAIL_DOMAINS=tcs.com
# true = exige cuenta corporativa de Google Workspace (el token trae "hd"). Úsalo solo si TCS usa Workspace.
GOOGLE_REQUIRE_HD=false
# true = el primer inicio de sesión crea el usuario como ASOCIADO
# false = solo entran usuarios que el Administrador dio de alta (POST /users)
AUTO_CREATE_USERS=true

# Solo en AUTH_MODE=demo: usuario por defecto si la petición no trae token ni x-demo-user.
DEFAULT_DEMO_USER=ana.asociado@demo.com

# --- Reglas de reserva (ajustables sin tocar código) ---
SLOT_MINUTES=30
MIN_ADVANCE_HOURS=24
MAX_DURATION_HOURS=48
CANCEL_MIN_HOURS=24
CHECKIN_BEFORE_MIN=15
CHECKIN_AFTER_MIN=15

# --- Notificaciones ---
# Canales extra además de la bandeja del sistema: vacío (fase 1), PUSH, EMAIL o PUSH,EMAIL
NOTIFY_CHANNELS=

# --- Tareas programadas ---
# Si la defines, los endpoints de tareas exigen la cabecera x-job-key con este valor.
JOB_KEY=
