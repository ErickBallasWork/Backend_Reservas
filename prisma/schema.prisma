// Modelo de datos del sistema de reservas en SQLite (Base de datos embebida local).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------- Catálogo ----------------

model Building {
  id        String   @id @default(uuid()) @map("Id")
  name      String   @unique @map("Name")
  address   String?  @map("Address")
  isActive  Boolean  @default(true) @map("IsActive")
  createdAt DateTime @default(now()) @map("CreatedAt")

  resources Resource[]
  userRoles UserRole[]

  @@map("BUILDING")
}

// Salas de reuniones, laboratorios de IA y laptops (las laptops cuelgan de su laboratorio).
model Resource {
  id               String   @id @default(uuid()) @map("Id")
  buildingId       String   @map("BuildingId")
  // Solo laptops: id del laboratorio de IA al que pertenecen
  parentResourceId String?  @map("ParentResourceId")
  // MEETING_ROOM | AI_LAB | LAPTOP
  type             String   @map("Type")
  name             String   @map("Name")
  capacity         Int      @default(1) @map("Capacity")
  equipment        String?  @map("Equipment")
  rules            String?  @map("Rules")
  // Solo laptops: código de inventario
  assetTag         String?  @map("AssetTag")
  isActive         Boolean  @default(true) @map("IsActive")
  createdAt        DateTime @default(now()) @map("CreatedAt")

  building          Building          @relation(fields: [buildingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent            Resource?         @relation("LabLaptops", fields: [parentResourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Resource[]        @relation("LabLaptops")
  reservations      Reservation[]
  slots             ReservationSlot[]
  reallocationsFrom Reallocation[]    @relation("ReallocationPrevious")
  reallocationsTo   Reallocation[]    @relation("ReallocationNew")

  @@unique([buildingId, name])
  @@index([type])
  @@index([parentResourceId])
  @@map("RESOURCE")
}

// ---------------- Usuarios y roles ----------------

model User {
  id          String    @id @default(uuid()) @map("Id")
  email       String    @unique @map("Email")
  fullName    String    @map("FullName")
  department  String?   @map("Department")
  tenantId    String?   @map("TenantId")
  isActive    Boolean   @default(true) @map("IsActive")
  lastLoginAt DateTime? @map("LastLoginAt")
  createdAt   DateTime  @default(now()) @map("CreatedAt")

  roles             UserRole[]
  reservations      Reservation[]
  approvals         Approval[]
  reallocations     Reallocation[]
  sanctions         Sanction[]     @relation("SanctionUser")
  sanctionsResolved Sanction[]     @relation("SanctionResolver")
  notifications     Notification[]
  auditLogs         AuditLog[]
  checkIns          CheckIn[]

  @@map("USERS")
}

// ASOCIADO | ADMIN | SPOC_ADMIN | LIDER | SPOC_EDIFICIO (se cargan con el seed)
model Role {
  id    Int        @id @default(autoincrement()) @map("Id")
  name  String     @unique @map("Name")
  users UserRole[]

  @@map("ROLE")
}

model UserRole {
  id         String  @id @default(uuid()) @map("Id")
  userId     String  @map("UserId")
  roleId     Int     @map("RoleId")
  buildingId String? @map("BuildingId")

  user     User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  building Building? @relation(fields: [buildingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("USER_ROLE")
}

// ---------------- Reservas ----------------

model Reservation {
  id              String   @id @default(uuid()) @map("Id")
  userId          String   @map("UserId")
  resourceId      String   @map("ResourceId")
  reservationType String   @map("ReservationType")
  purpose         String   @map("Purpose")
  justification   String   @map("Justification")
  startDateTime   DateTime @map("StartDateTime")
  endDateTime     DateTime @map("EndDateTime")
  status          String   @map("Status")
  createdAt       DateTime @default(now()) @map("CreatedAt")
  updatedAt       DateTime @updatedAt @map("UpdatedAt")

  user          User              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource      Resource          @relation(fields: [resourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slots         ReservationSlot[]
  approvals     Approval[]
  reallocations Reallocation[]
  sanctions     Sanction[]
  checkIn       CheckIn?

  @@index([userId, startDateTime])
  @@index([resourceId, startDateTime])
  @@index([status, startDateTime])
  @@map("RESERVATION")
}

model ReservationSlot {
  id            String   @id @default(uuid()) @map("Id")
  reservationId String   @map("ReservationId")
  resourceId    String   @map("ResourceId")
  slotStart     DateTime @map("SlotStart")
  slotEnd       DateTime @map("SlotEnd")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([resourceId, slotStart], map: "UQ_RESERVATION_SLOT_Resource_SlotStart")
  @@index([reservationId])
  @@index([slotStart])
  @@map("RESERVATION_SLOT")
}

model CheckIn {
  id            String   @id @default(uuid()) @map("Id")
  reservationId String   @unique @map("ReservationId")
  userId        String   @map("UserId")
  checkInDate   DateTime @default(now()) @map("CheckInDate")
  method        String   @map("Method")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("CHECK_IN")
}

// ---------------- Aprobaciones, reasignaciones y sanciones ----------------

model Approval {
  id            String   @id @default(uuid()) @map("Id")
  reservationId String   @map("ReservationId")
  approverId    String   @map("ApproverId")
  status        String   @map("Status")
  comments      String?  @map("Comments")
  decisionDate  DateTime @default(now()) @map("DecisionDate")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approver    User        @relation(fields: [approverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reservationId])
  @@map("APPROVAL")
}

model Reallocation {
  id                    String   @id @default(uuid()) @map("Id")
  reservationId         String   @map("ReservationId")
  previousResourceId    String   @map("PreviousResourceId")
  newResourceId         String   @map("NewResourceId")
  responsibleUserId     String   @map("ResponsibleUserId")
  previousStartDateTime DateTime @map("PreviousStartDateTime")
  previousEndDateTime   DateTime @map("PreviousEndDateTime")
  newStartDateTime      DateTime @map("NewStartDateTime")
  newEndDateTime        DateTime @map("NewEndDateTime")
  justification         String   @map("Justification")
  reallocationDate      DateTime @default(now()) @map("ReallocationDate")

  reservation      Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  previousResource Resource    @relation("ReallocationPrevious", fields: [previousResourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  newResource      Resource    @relation("ReallocationNew", fields: [newResourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsibleUser  User        @relation(fields: [responsibleUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reservationId])
  @@map("REALLOCATION")
}

model Sanction {
  id            String    @id @default(uuid()) @map("Id")
  userId        String    @map("UserId")
  reservationId String    @map("ReservationId")
  type          String    @default("NO_SHOW") @map("Type")
  reason        String    @map("Reason")
  startDate     DateTime  @default(now()) @map("StartDate")
  endDate       DateTime? @map("EndDate")
  status        String    @map("Status")
  resolvedById  String?   @map("ResolvedById")
  resolvedAt    DateTime? @map("ResolvedAt")

  user        User        @relation("SanctionUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedBy  User?       @relation("SanctionResolver", fields: [resolvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, status])
  @@map("SANCTION")
}

// ---------------- Notificaciones y auditoría ----------------

model Notification {
  id        String    @id @default(uuid()) @map("Id")
  userId    String    @map("UserId")
  channel   String    @default("IN_APP") @map("Channel")
  type      String    @map("Type")
  title     String    @map("Title")
  message   String    @map("Message")
  isRead    Boolean   @default(false) @map("IsRead")
  status    String    @default("SENT") @map("Status")
  attempts  Int       @default(0) @map("Attempts")
  sentAt    DateTime? @map("SentAt")
  createdAt DateTime  @default(now()) @map("CreatedAt")

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, channel, isRead])
  @@index([channel, status])
  @@map("NOTIFICATION")
}

model AuditLog {
  id        Int      @id @default(autoincrement()) @map("Id")
  userId    String?  @map("UserId")
  action    String   @map("Action")
  entity    String   @map("Entity")
  entityId  String?  @map("EntityId")
  details   String?  @map("Details")
  eventDate DateTime @default(now()) @map("EventDate")

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity, entityId])
  @@index([eventDate])
  @@map("AUDIT_LOG")
}
