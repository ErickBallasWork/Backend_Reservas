// Modelo de datos del sistema de reservas (SQL Server: local en Docker o Azure SQL).
//
// Basado en el diagrama del equipo de base de datos, con estas correcciones:
//  - Las laptops son filas de RESOURCE (Type = LAPTOP) con ParentResourceId = su laboratorio.
//    Así RESERVATION y RESERVATION_SLOT apuntan siempre a RESOURCE con una llave foránea real.
//  - RESERVATION_SLOT tiene la clave única (ResourceId, SlotStart): impide las dobles reservas.
//  - USER_ROLE.BuildingId (SPOC de Edificio por edificio), USERS.Department (reportes),
//    SANCTION.ResolvedById/ResolvedAt (quién regularizó), AUDIT_LOG.Details y UserId opcional,
//    REALLOCATION con horario anterior y nuevo, y la tabla USERS (USER es palabra reservada).
//
// Notas de Prisma con SQL Server:
//  - Los modelos usan nombres en inglés para el código y @@map / @map para los nombres reales
//    de tablas y columnas en la base (BUILDING, Id, BuildingId...).
//  - SQL Server no admite enums en Prisma: tipos y estados son texto validado en el código
//    (src/common/constants.ts).
//  - Todas las relaciones usan NoAction: SQL Server rechaza "múltiples caminos de cascada" y
//    en este sistema nada se borra (se inactiva).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ---------------- Catálogo ----------------

model Building {
  id        String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  name      String   @unique @map("Name") @db.NVarChar(150)
  address   String?  @map("Address") @db.NVarChar(300)
  isActive  Boolean  @default(true) @map("IsActive")
  createdAt DateTime @default(now()) @map("CreatedAt")

  resources Resource[]
  userRoles UserRole[]

  @@map("BUILDING")
}

// Salas de reuniones, laboratorios de IA y laptops (las laptops cuelgan de su laboratorio).
model Resource {
  id               String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  buildingId       String   @map("BuildingId") @db.UniqueIdentifier
  // Solo laptops: id del laboratorio de IA al que pertenecen
  parentResourceId String?  @map("ParentResourceId") @db.UniqueIdentifier
  // MEETING_ROOM | AI_LAB | LAPTOP
  type             String   @map("Type") @db.NVarChar(20)
  name             String   @map("Name") @db.NVarChar(150)
  capacity         Int      @default(1) @map("Capacity")
  equipment        String?  @map("Equipment") @db.NVarChar(500)
  rules            String?  @map("Rules") @db.NVarChar(500)
  // Solo laptops: código de inventario
  assetTag         String?  @map("AssetTag") @db.NVarChar(50)
  isActive         Boolean  @default(true) @map("IsActive")
  createdAt        DateTime @default(now()) @map("CreatedAt")

  building          Building          @relation(fields: [buildingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent            Resource?         @relation("LabLaptops", fields: [parentResourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Resource[]        @relation("LabLaptops")
  reservations      Reservation[]
  slots             ReservationSlot[]
  reallocationsFrom Reallocation[]    @relation("ReallocationPrevious")
  reallocationsTo   Reallocation[]    @relation("ReallocationNew")

  @@unique([buildingId, name])
  @@index([type])
  @@index([parentResourceId])
  @@map("RESOURCE")
}

// ---------------- Usuarios y roles ----------------

model User {
  id          String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  email       String    @unique @map("Email") @db.NVarChar(320)
  fullName    String    @map("FullName") @db.NVarChar(200)
  department  String?   @map("Department") @db.NVarChar(120)
  isActive    Boolean   @default(true) @map("IsActive")
  lastLoginAt DateTime? @map("LastLoginAt")
  createdAt   DateTime  @default(now()) @map("CreatedAt")

  roles              UserRole[]
  reservations       Reservation[]
  approvals          Approval[]
  reallocations      Reallocation[]
  sanctions          Sanction[]         @relation("SanctionUser")
  sanctionsResolved  Sanction[]         @relation("SanctionResolver")
  notifications      Notification[]
  auditLogs          AuditLog[]
  checkIns           CheckIn[]
  accessDecisions    AccessRequest[]    @relation("AccessRequestDecider")
  devices            Device[]
  managedAssociates  ManagedAssociate[] @relation("ManagerAssociates")
  managers           ManagedAssociate[] @relation("AssociateManagers")
  assignedAssociates ManagedAssociate[] @relation("ManagedAssociateCreator")

  @@map("USERS")
}

// NEW_USER | NEW_DEVICE. Una solicitud aprobada habilita un dispositivo concreto (ADR-023, Q-14).
model AccessRequest {
  id               String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  email            String    @map("Email") @db.NVarChar(320)
  fullName         String    @map("FullName") @db.NVarChar(200)
  department       String?   @map("Department") @db.NVarChar(120)
  kind             String    @map("Kind") @db.NVarChar(12)
  // PENDING | APPROVED | REJECTED
  status           String    @default("PENDING") @map("Status") @db.NVarChar(10)
  deviceSecretHash String    @map("DeviceSecretHash") @db.NVarChar(64)
  deviceLabel      String?   @map("DeviceLabel") @db.NVarChar(200)
  requestedAt      DateTime  @default(now()) @map("RequestedAt")
  decidedAt        DateTime? @map("DecidedAt")
  decidedById      String?   @map("DecidedById") @db.UniqueIdentifier
  decisionComment  String?   @map("DecisionComment") @db.NVarChar(500)
  redeemedAt       DateTime? @map("RedeemedAt")

  decidedBy User? @relation("AccessRequestDecider", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, requestedAt])
  @@index([email, status])
  @@map("ACCESS_REQUEST")
}

// Asociados a cargo de un SPOC_ADMIN o LIDER (Q-03): asignación manual, un asociado puede tener varios.
model ManagedAssociate {
  id          String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  managerId   String   @map("ManagerId") @db.UniqueIdentifier
  associateId String   @map("AssociateId") @db.UniqueIdentifier
  createdById String   @map("CreatedById") @db.UniqueIdentifier
  createdAt   DateTime @default(now()) @map("CreatedAt")

  manager   User @relation("ManagerAssociates", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  associate User @relation("AssociateManagers", fields: [associateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy User @relation("ManagedAssociateCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([managerId, associateId])
  @@index([associateId])
  @@map("MANAGED_ASSOCIATE")
}

// Navegador aprobado de un usuario. Guarda solo hashes del refresh token, que rota en cada uso.
model Device {
  id                       String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId                   String    @map("UserId") @db.UniqueIdentifier
  label                    String?   @map("Label") @db.NVarChar(200)
  refreshTokenHash         String    @unique @map("RefreshTokenHash") @db.NVarChar(64)
  previousRefreshTokenHash String?   @map("PreviousRefreshTokenHash") @db.NVarChar(64)
  rotatedAt                DateTime? @map("RotatedAt")
  expiresAt                DateTime  @map("ExpiresAt")
  createdAt                DateTime  @default(now()) @map("CreatedAt")
  lastUsedAt               DateTime  @default(now()) @map("LastUsedAt")
  revokedAt                DateTime? @map("RevokedAt")

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([previousRefreshTokenHash])
  @@map("DEVICE")
}

// ASOCIADO | ADMIN | SPOC_ADMIN | LIDER | SPOC_EDIFICIO | SUPERADMIN (se cargan con el seed)
model Role {
  id    Int        @id @default(autoincrement()) @map("Id")
  name  String     @unique @map("Name") @db.NVarChar(30)
  users UserRole[]

  @@map("ROLE")
}

model UserRole {
  id         String  @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId     String  @map("UserId") @db.UniqueIdentifier
  roleId     Int     @map("RoleId")
  // Solo SPOC_EDIFICIO: edificio que administra
  buildingId String? @map("BuildingId") @db.UniqueIdentifier

  user     User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  building Building? @relation(fields: [buildingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@map("USER_ROLE")
}

// ---------------- Reservas ----------------

model Reservation {
  id              String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId          String   @map("UserId") @db.UniqueIdentifier
  // Sala, laboratorio (reserva completa) o laptop
  resourceId      String   @map("ResourceId") @db.UniqueIdentifier
  // ROOM | FULL_LAB | LAPTOP
  reservationType String   @map("ReservationType") @db.NVarChar(20)
  // Motivo: INTERNAL_MEETING | CLIENT_MEETING | TRAINING
  purpose         String   @map("Purpose") @db.NVarChar(30)
  // Detalle o justificación del motivo (RF-07)
  justification   String   @map("Justification") @db.NVarChar(1000)
  startDateTime   DateTime @map("StartDateTime")
  endDateTime     DateTime @map("EndDateTime")
  // PENDING_APPROVAL | CONFIRMED | REJECTED | CANCELLED | CHECKED_IN | NO_SHOW
  status          String   @map("Status") @db.NVarChar(20)
  createdAt       DateTime @default(now()) @map("CreatedAt")
  updatedAt       DateTime @updatedAt @map("UpdatedAt")

  user          User              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource      Resource          @relation(fields: [resourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slots         ReservationSlot[]
  approvals     Approval[]
  reallocations Reallocation[]
  sanctions     Sanction[]
  checkIn       CheckIn?

  @@index([userId, startDateTime])
  @@index([resourceId, startDateTime])
  @@index([status, startDateTime])
  @@map("RESERVATION")
}

// Franjas ocupadas. Una reserva de 10:00 a 11:00 con franjas de 30 min crea 2 filas por recurso.
// La clave única (ResourceId, SlotStart) hace que la base rechace cualquier doble reserva.
model ReservationSlot {
  id            String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  reservationId String   @map("ReservationId") @db.UniqueIdentifier
  resourceId    String   @map("ResourceId") @db.UniqueIdentifier
  slotStart     DateTime @map("SlotStart")
  slotEnd       DateTime @map("SlotEnd")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([resourceId, slotStart], map: "UQ_RESERVATION_SLOT_Resource_SlotStart")
  @@index([reservationId])
  @@index([slotStart])
  @@map("RESERVATION_SLOT")
}

model CheckIn {
  id            String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  reservationId String   @unique @map("ReservationId") @db.UniqueIdentifier
  userId        String   @map("UserId") @db.UniqueIdentifier
  checkInDate   DateTime @default(now()) @map("CheckInDate")
  // BUTTON | QR
  method        String   @map("Method") @db.NVarChar(20)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("CHECK_IN")
}

// ---------------- Aprobaciones, reasignaciones y sanciones ----------------

model Approval {
  id            String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  reservationId String   @map("ReservationId") @db.UniqueIdentifier
  approverId    String   @map("ApproverId") @db.UniqueIdentifier
  // APPROVED | REJECTED
  status        String   @map("Status") @db.NVarChar(10)
  comments      String?  @map("Comments") @db.NVarChar(1000)
  decisionDate  DateTime @default(now()) @map("DecisionDate")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approver    User        @relation(fields: [approverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reservationId])
  @@map("APPROVAL")
}

model Reallocation {
  id                    String   @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  reservationId         String   @map("ReservationId") @db.UniqueIdentifier
  previousResourceId    String   @map("PreviousResourceId") @db.UniqueIdentifier
  newResourceId         String   @map("NewResourceId") @db.UniqueIdentifier
  responsibleUserId     String   @map("ResponsibleUserId") @db.UniqueIdentifier
  previousStartDateTime DateTime @map("PreviousStartDateTime")
  previousEndDateTime   DateTime @map("PreviousEndDateTime")
  newStartDateTime      DateTime @map("NewStartDateTime")
  newEndDateTime        DateTime @map("NewEndDateTime")
  justification         String   @map("Justification") @db.NVarChar(1000)
  reallocationDate      DateTime @default(now()) @map("ReallocationDate")

  reservation      Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  previousResource Resource    @relation("ReallocationPrevious", fields: [previousResourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  newResource      Resource    @relation("ReallocationNew", fields: [newResourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responsibleUser  User        @relation(fields: [responsibleUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reservationId])
  @@map("REALLOCATION")
}

model Sanction {
  id            String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId        String    @map("UserId") @db.UniqueIdentifier
  reservationId String    @map("ReservationId") @db.UniqueIdentifier
  // NO_SHOW
  type          String    @default("NO_SHOW") @map("Type") @db.NVarChar(20)
  reason        String    @map("Reason") @db.NVarChar(300)
  startDate     DateTime  @default(now()) @map("StartDate")
  // Vacío mientras esté activa: dura hasta que un Administrador la regularice (RF-12)
  endDate       DateTime? @map("EndDate")
  // ACTIVE | RESOLVED
  status        String    @map("Status") @db.NVarChar(10)
  resolvedById  String?   @map("ResolvedById") @db.UniqueIdentifier
  resolvedAt    DateTime? @map("ResolvedAt")

  user        User        @relation("SanctionUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedBy  User?       @relation("SanctionResolver", fields: [resolvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, status])
  @@map("SANCTION")
}

// ---------------- Notificaciones y auditoría ----------------

// Un aviso por canal. IN_APP es la bandeja del sistema (canal por defecto); PUSH y EMAIL
// quedan como envíos pendientes (Status = PENDING) hasta que una tarea los procese.
model Notification {
  id        String    @id @default(uuid()) @map("Id") @db.UniqueIdentifier
  userId    String    @map("UserId") @db.UniqueIdentifier
  // IN_APP | PUSH | EMAIL
  channel   String    @default("IN_APP") @map("Channel") @db.NVarChar(10)
  type      String    @map("Type") @db.NVarChar(40)
  title     String    @map("Title") @db.NVarChar(200)
  message   String    @map("Message") @db.NVarChar(1000)
  isRead    Boolean   @default(false) @map("IsRead")
  // PENDING | SENT | FAILED
  status    String    @default("SENT") @map("Status") @db.NVarChar(10)
  attempts  Int       @default(0) @map("Attempts")
  sentAt    DateTime? @map("SentAt")
  createdAt DateTime  @default(now()) @map("CreatedAt")

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, channel, isRead])
  @@index([channel, status])
  @@map("NOTIFICATION")
}

// Solo inserción: el usuario de la aplicación no debe poder editar ni borrar (docs/sql).
model AuditLog {
  id        BigInt   @id @default(autoincrement()) @map("Id")
  // Vacío cuando la acción la hace una tarea automática (por ejemplo, el No-Show)
  userId    String?  @map("UserId") @db.UniqueIdentifier
  action    String   @map("Action") @db.NVarChar(60)
  entity    String   @map("Entity") @db.NVarChar(60)
  entityId  String?  @map("EntityId") @db.NVarChar(60)
  // Qué cambió (antes y después) en JSON
  details   String?  @map("Details") @db.NVarChar(Max)
  eventDate DateTime @default(now()) @map("EventDate")

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity, entityId])
  @@index([eventDate])
  @@map("AUDIT_LOG")
}
